<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SarmadiVpn</AssemblyName>
    <Product>SARMADI VPN</Product>
    <ApplicationIcon>Assets\sarmadi-vpn.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\sarmadi-vpn.png" />
    <Resource Include="Assets\sarmadi-vpn.ico" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="..\SarmadiVpn.Core\SarmadiVpn.Core.csproj" /></ItemGroup>
</Project>
