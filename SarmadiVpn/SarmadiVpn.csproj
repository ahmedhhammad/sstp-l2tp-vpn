<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SarmadiVpn</AssemblyName>
    <Product>SARMADI VPN</Product>
    <Version>0.1.0-preview.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>SARMADI VPN contributors</Authors>
    <Description>Windows SSTP/L2TP VPN client with IPv4 split-route management.</Description>
    <RepositoryUrl>https://github.com/ahmedhhammad/sstp-l2tp-vpn</RepositoryUrl>
    <ApplicationIcon>Assets\sarmadi-vpn.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\sarmadi-vpn.png" />
    <Resource Include="Assets\sarmadi-vpn.ico" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="..\SarmadiVpn.Core\SarmadiVpn.Core.csproj" /></ItemGroup>
</Project>
