<Window x:Class="SarmadiVpn.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:SarmadiVpn.Core;assembly=SarmadiVpn.Core"
 Title="SARMADI VPN" Icon="pack://application:,,,/SarmadiVpn;component/Assets/sarmadi-vpn.png" Height="700" Width="820" MinHeight="660" MinWidth="780"
 WindowStartupLocation="CenterScreen" WindowState="Normal"
 Background="#F3F5F4" Foreground="#202A30" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="GroupBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D4DCDA"/><Setter Property="Foreground" Value="#202A30"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/><Setter Property="BorderBrush" Value="#D4DCDA"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,10,8"/><Setter Property="MinWidth" Value="140"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,10,8"/><Setter Property="MinWidth" Value="140"/></Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
 <Grid Width="860" Height="700" Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,14">
   <Image DockPanel.Dock="Left" Source="pack://application:,,,/SarmadiVpn;component/Assets/sarmadi-vpn.png" Width="56" Height="56" Margin="0,0,12,0" Stretch="Uniform"/>
   <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="SARMADI VPN" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Windows VPN and route manager" Foreground="#5E6A70" Margin="0,2,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Grid x:Name="BusyArrow" Width="22" Height="22" Margin="0,0,6,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
     <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="18" Width="22" Height="22" Foreground="#D69E00" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
     <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
       <Setter Property="Visibility" Value="Visible"/>
       <DataTrigger.EnterActions><BeginStoryboard Name="BusyArrowSpin"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
       <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="BusyArrowSpin"/></DataTrigger.ExitActions>
      </DataTrigger>
     </Style.Triggers></Style></Grid.Style>
    </Grid>
    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
     <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#B13B32"/><Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:VpnState.Connected}"><Setter Property="Fill" Value="#22C55E"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:VpnState.Connecting}"><Setter Property="Fill" Value="#D69E00"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:VpnState.Disconnecting}"><Setter Property="Fill" Value="#D69E00"/></DataTrigger>
     </Style.Triggers></Style></Ellipse.Style>
    </Ellipse>
    <TextBlock Text="{Binding StateText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>

  <GroupBox Grid.Row="1" Header="VPN connection">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Column="0" IsEnabled="{Binding CanEditConnection}"><TextBlock Text="Server address"/><TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" ToolTip="VPN server DNS name or IP"/></StackPanel>
    <StackPanel Grid.Column="1" IsEnabled="{Binding CanEditConnection}"><TextBlock Text="Username"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <StackPanel Grid.Column="2" IsEnabled="{Binding CanEditConnection}"><TextBlock Text="Protocol"/><ComboBox Margin="0,4,0,8" Padding="7,6" SelectedValue="{Binding Protocol}" SelectedValuePath="Tag">
     <ComboBoxItem Content="SSTP" Tag="{x:Static core:VpnProtocol.Sstp}"/><ComboBoxItem Content="L2TP / IPsec" Tag="{x:Static core:VpnProtocol.L2tp}"/>
    </ComboBox></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="0" IsEnabled="{Binding CanEditConnection}"><TextBlock Text="Password"/><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8" IsEnabled="{Binding CanEditConnection}"><CheckBox Content="Remember credentials" IsChecked="{Binding RememberCredentials}" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" x:Name="L2tpPanel" Visibility="Collapsed" IsEnabled="{Binding CanEditConnection}"><TextBlock Text="L2TP pre-shared key"/><PasswordBox x:Name="PskInput" PasswordChanged="PskInput_PasswordChanged"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,0">
     <Button Content="Connect" Command="{Binding ConnectCommand}" Background="#176B65" Foreground="White" BorderBrush="#176B65" FontWeight="SemiBold"/>
     <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Background="#FCE8E6" Foreground="#8E2D27" BorderBrush="#E7A6A1"/>
     <Button Content="Enable L2TP behind NAT" Command="{Binding NatCommand}"/>
    </StackPanel>
   </Grid>
  </GroupBox>

  <GroupBox Grid.Row="2" Header="Split-tunnel routes">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="IPv4 address or CIDR"/><TextBox Text="{Binding NewDestination, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example 192.168.1.0/24"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Label (optional)"/><TextBox Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <Button Grid.Column="2" Content="Add route" Command="{Binding AddRouteCommand}" VerticalAlignment="Bottom" Background="#176B65" Foreground="White" BorderBrush="#176B65"/>
     <Button Grid.Column="3" Content="Delete selected" Command="{Binding DeleteRouteCommand}" VerticalAlignment="Bottom"/>
    </Grid>
    <DataGrid x:Name="RouteGrid" Grid.Row="1" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" CellEditEnding="RouteGrid_CellEditEnding" IsReadOnly="False" CanUserSortColumns="True">
     <DataGrid.Columns>
      <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
      <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" IsReadOnly="True" Width="190"/>
      <DataGridTextColumn Header="Label" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="2*"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="Only enabled destinations use the VPN. 0.0.0.0/0 is blocked to protect the normal default route." Foreground="#5E6A70" Margin="0,8,0,0" TextWrapping="Wrap"/>
   </Grid>
  </GroupBox>

  <GroupBox Grid.Row="3" Header="Activity log" Margin="0">
   <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" Background="#F7F9F8" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
  </GroupBox>
 </Grid>
 </Viewbox>
</Window>
